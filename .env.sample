# Credentials for the WordPress and Contentful import suites
# (`npm run test:integration -w @datocms/cli-plugin-wordpress`, and the same for
# `-contentful`). They log in to these accounts and create a throwaway project
# in them, so use accounts dedicated to testing — nothing else should live there.
#
# A comma-separated pool is supported: they must share the password and the
# organization, and the suites move to the next one when a login is rate-limited.
DATOCMS_ACCOUNT_EMAIL=""
DATOCMS_ACCOUNT_PASSWORD=""
DATOCMS_ORGANIZATION_ID=""

# Contentful import suite only: a read-write management token.
CONTENTFUL_TOKEN=""
