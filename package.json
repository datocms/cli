{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "format": "biome check toolchain packages --apply-unsafe && biome format --write toolchain packages",
    "lint": "biome ci packages",
    "build": "turbo run build",
    "test": "turbo run test",
    "changeset": "changeset",
    "release": "node toolchain/release.mjs",
    "release:next": "node toolchain/release.mjs --tag next"
  },
  "devDependencies": {
    "@biomejs/biome": "1.6.4",
    "@changesets/cli": "^3.0.1",
    "@datocms/release-toolchain": "github:datocms/release-toolchain#v1.1.0",
    "@datocms/dashboard-client": "^6.1.0",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^22.10.2",
    "chai": "^4",
    "dotenv": "^16.6.1",
    "globby": "^11",
    "husky": "^7.0.4",
    "lint-staged": "^13.1.0",
    "mocha": "^10",
    "oclif": "^4",
    "pkg-pr-new": "^0.0.88",
    "rimraf": "^3.0.2",
    "ts-node": "^10.2.1",
    "tslib": "^2.3.1",
    "turbo": "^2.10.11",
    "typescript": "5.7.2"
  },
  "version": "0.0.1",
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx}": [
      "biome ci"
    ]
  },
  "files": [],
  "husky": {
    "hooks": {
      "pre-commit": "./node_modules/.bin/lint-staged"
    }
  },
  "packageManager": "npm@10.8.2"
}
